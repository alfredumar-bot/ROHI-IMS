<ServerConnectionScreen>:
    MDScreen:
        md_bg_color: 0.95, 0.95, 0.95, 1

        MDBoxLayout:
            orientation: 'vertical'

            MDTopAppBar:
                title: "Server Connection"
                elevation: 2
                md_bg_color: 0.13, 0.40, 0.16, 1
                left_action_items: [["arrow-left", lambda x: app.lock_google_links() or app.open_settings_screen()]]

            ScrollView:
                do_scroll_x: False

                MDBoxLayout:
                    orientation: 'vertical'
                    padding: dp(16)
                    spacing: dp(16)
                    size_hint_y: None
                    height: self.minimum_height

                    # ---------------- Status Card ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(6)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDBoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(10)
                            adaptive_height: True

                            MDLabel:
                                text: "Connection Status:"
                                bold: True
                                adaptive_size: True
                                valign: "middle"

                            Widget:
                                size_hint_x: None
                                width: dp(1)

                            MDCard:
                                id: connection_status_badge
                                orientation: 'horizontal'
                                size_hint: None, None
                                size: self.minimum_width, dp(30)
                                padding: [dp(10), dp(4)]
                                spacing: dp(6)
                                radius: [15,]
                                elevation: 0
                                md_bg_color: 0.93, 0.85, 0.85, 1

                                MDIcon:
                                    id: connection_status_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.6, 0.15, 0.15, 1
                                    size_hint: None, None
                                    size: dp(18), dp(18)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: connection_status_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.6, 0.15, 0.15, 1
                                    adaptive_size: True
                                    valign: "middle"
                                    pos_hint: {"center_y": .5}

                        MDLabel:
                            id: last_sync_label
                            text: "Last Sync: Never"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                        MDLabel:
                            id: sync_result_label
                            text: ""
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                    # ---------------- Connection Fields ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(12)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDTextField:
                            id: server_name_field
                            hint_text: "Server Name"

                        MDTextField:
                            id: host_field
                            hint_text: "Host / IP"

                        MDTextField:
                            id: port_field
                            hint_text: "Port"
                            input_filter: "int"
                            text: "5432"

                        MDTextField:
                            id: dbname_field
                            hint_text: "Database Name"

                        MDTextField:
                            id: username_field
                            hint_text: "Username"

                        MDTextField:
                            id: password_field
                            hint_text: "Password"
                            password: True

                        MDTextField:
                            id: sslmode_field
                            hint_text: "SSL Mode (disable / allow / prefer / require)"
                            text: "prefer"

                    # ---------------- Excel Auto-Sync Connections ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDLabel:
                            text: "Excel Auto-Sync Connections"
                            font_style: "Subtitle1"
                            bold: True
                            adaptive_height: True

                        MDLabel:
                            text: "The Google link is the destination. The upload endpoint is the secure bridge that lets ROHI send files/data automatically without opening Google or asking the user to choose an account."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True
                            text_size: self.width, None

                        # ---------------- Google Links Lock (same password as Reset Database) ----------------
                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(8)
                            adaptive_height: True

                            MDCard:
                                orientation: "horizontal"
                                size_hint_x: 0.42
                                size_hint_y: None
                                height: dp(36)
                                padding: [dp(8), dp(4)]
                                radius: [18,]
                                elevation: 0
                                md_bg_color: (0.87, 0.95, 0.88, 1) if app.google_links_unlocked else (0.96, 0.87, 0.87, 1)

                                MDIcon:
                                    icon: "lock-open-variant-outline" if app.google_links_unlocked else "lock-outline"
                                    theme_text_color: "Custom"
                                    text_color: (0.13, 0.45, 0.18, 1) if app.google_links_unlocked else (0.80, 0.10, 0.10, 1)
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    text: "Unlocked" if app.google_links_unlocked else "Locked"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: (0.13, 0.45, 0.18, 1) if app.google_links_unlocked else (0.80, 0.10, 0.10, 1)
                                    adaptive_height: True
                                    pos_hint: {"center_y": .5}

                            MDRaisedButton:
                                text: "LOCK GOOGLE LINKS" if app.google_links_unlocked else "UNLOCK GOOGLE LINKS"
                                size_hint_x: 0.58
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                on_release: app.lock_google_links() if app.google_links_unlocked else app.unlock_google_links()

                        MDLabel:
                            text: "Links and endpoints are hidden and cannot be edited until unlocked with the administrator (Reset Database) password."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True
                            text_size: self.width, None

                        MDTextField:
                            id: dwpt_link_field
                            hint_text: "DWPT Google Drive folder link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDTextField:
                            id: monthly_report_link_field
                            hint_text: "Monthly Report Google Drive folder link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDTextField:
                        MDTextField:
                            id: dwpt_endpoint_field
                            hint_text: "DWPT automatic upload endpoint (required for Send to Google)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDTextField:
                            id: monthly_report_endpoint_field
                            hint_text: "Monthly Report automatic upload endpoint (required for Send to Google)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                            id: attendance_link_field
                            hint_text: "ROHI Attendance Report link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(8)
                            adaptive_height: True

                            MDCard:
                                id: attendance_connection_badge
                                orientation: "horizontal"
                                size_hint_x: 0.42
                                size_hint_y: None
                                height: dp(36)
                                padding: [dp(8), dp(4)]
                                radius: [18,]
                                elevation: 0
                                md_bg_color: 0.96, 0.87, 0.87, 1

                                MDIcon:
                                    id: attendance_connection_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: attendance_connection_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    adaptive_height: True
                                    pos_hint: {"center_y": .5}

                            MDRaisedButton:
                                text: "CONNECT ATTENDANCE"
                                size_hint_x: 0.58
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                disabled: False
                                on_release: app.connect_excel_report("attendance")

                        MDTextField:
                            id: attendance_endpoint_field
                            hint_text: "Attendance automatic upload endpoint (required for Send to Google)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDTextField:
                            id: timesheet_link_field
                            hint_text: "ROHI Timesheet folder/link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(8)
                            adaptive_height: True

                            MDCard:
                                id: timesheet_connection_badge
                                orientation: "horizontal"
                                size_hint_x: 0.42
                                size_hint_y: None
                                height: dp(36)
                                padding: [dp(8), dp(4)]
                                radius: [18,]
                                elevation: 0
                                md_bg_color: 0.96, 0.87, 0.87, 1

                                MDIcon:
                                    id: timesheet_connection_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: timesheet_connection_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    adaptive_height: True
                                    pos_hint: {"center_y": .5}

                            MDRaisedButton:
                                text: "CONNECT TIMESHEET"
                                size_hint_x: 0.58
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                disabled: False
                                on_release: app.connect_excel_report("timesheet")

                        MDTextField:
                            id: timesheet_endpoint_field
                            hint_text: "Timesheet automatic upload endpoint (required for Send to Google)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDTextField:
                            id: leave_link_field
                            hint_text: "ROHI Leave Management folder/link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(8)
                            adaptive_height: True

                            MDCard:
                                id: leave_connection_badge
                                orientation: "horizontal"
                                size_hint_x: 0.42
                                size_hint_y: None
                                height: dp(36)
                                padding: [dp(8), dp(4)]
                                radius: [18,]
                                elevation: 0
                                md_bg_color: 0.96, 0.87, 0.87, 1

                                MDIcon:
                                    id: leave_connection_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: leave_connection_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    adaptive_height: True
                                    pos_hint: {"center_y": .5}

                            MDRaisedButton:
                                text: "CONNECT LEAVE"
                                size_hint_x: 0.58
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                disabled: False
                                on_release: app.connect_excel_report("leave")

                        MDTextField:
                            id: leave_endpoint_field
                            hint_text: "Leave automatic upload endpoint (required for Send to Google)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDTextField:
                            id: staff_link_field
                            hint_text: "ROHI Complete Staff on IMS link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(8)
                            adaptive_height: True

                            MDCard:
                                id: staff_connection_badge
                                orientation: "horizontal"
                                size_hint_x: 0.42
                                size_hint_y: None
                                height: dp(36)
                                padding: [dp(8), dp(4)]
                                radius: [18,]
                                elevation: 0
                                md_bg_color: 0.96, 0.87, 0.87, 1

                                MDIcon:
                                    id: staff_connection_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: staff_connection_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    adaptive_height: True
                                    pos_hint: {"center_y": .5}

                            MDRaisedButton:
                                text: "CONNECT STAFF"
                                size_hint_x: 0.58
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                disabled: False
                                on_release: app.connect_excel_report("staff")

                        MDTextField:
                            id: cfm_link_field
                            hint_text: "ROHI CFM Excel / Google Sheet link"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(8)
                            adaptive_height: True

                            MDCard:
                                id: cfm_connection_badge
                                orientation: "horizontal"
                                size_hint_x: 0.42
                                size_hint_y: None
                                height: dp(36)
                                padding: [dp(8), dp(4)]
                                radius: [18,]
                                elevation: 0
                                md_bg_color: 0.96, 0.87, 0.87, 1

                                MDIcon:
                                    id: cfm_connection_icon
                                    icon: "close-circle"
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": .5}

                                MDLabel:
                                    id: cfm_connection_label
                                    text: "Not Connected"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.80, 0.10, 0.10, 1
                                    adaptive_height: True
                                    pos_hint: {"center_y": .5}

                            MDRaisedButton:
                                text: "CONNECT CFM"
                                size_hint_x: 0.58
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                disabled: False
                                on_release: app.connect_excel_report("cfm")

                        MDTextField:
                            id: cfm_endpoint_field
                            hint_text: "CFM automatic upload endpoint (same Google Apps Script /exec link)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        # ---------------- CFM Backup & Restore ----------------
                        MDCard:
                            orientation: 'vertical'
                            padding: dp(14)
                            spacing: dp(8)
                            size_hint_y: None
                            height: self.minimum_height
                            radius: [12,]
                            elevation: 2

                            MDLabel:
                                text: "Backup & Restore"
                                bold: True
                                font_style: "Subtitle1"
                                adaptive_height: True

                            MDLabel:
                                text: "Export all ROHI local data to move to another phone, or import a previous ROHI backup. The old login session is not restored."
                                font_style: "Caption"
                                theme_text_color: "Secondary"
                                adaptive_height: True
                                text_size: self.width, None

                            MDBoxLayout:
                                spacing: dp(8)
                                adaptive_height: True

                                MDRaisedButton:
                                    text: "EXPORT BACKUP"
                                    size_hint_x: 0.5
                                    md_bg_color: 0.13, 0.40, 0.16, 1
                                    on_release: app.export_full_backup()

                                MDRaisedButton:
                                    text: "IMPORT BACKUP"
                                    size_hint_x: 0.5
                                    md_bg_color: 0.13, 0.40, 0.16, 1
                                    on_release: app.import_full_backup()

                            MDLabel:
                                id: server_backup_status_label
                                text: "No backup action performed."
                                font_style: "Caption"
                                theme_text_color: "Secondary"
                                adaptive_height: True
                                text_size: self.width, None

                        MDTextField:
                            id: staff_endpoint_field
                            hint_text: "Staff automatic upload endpoint (required for Send to Google)"
                            multiline: True
                            size_hint_y: None
                            height: dp(64)
                            readonly: not app.google_links_unlocked
                            opacity: 1

                        MDLabel:
                            id: excel_sync_result_label
                            text: "Links are preloaded from the supplied auto-sync workbook."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True
                            text_size: self.width, None

                        MDBoxLayout:
                            spacing: dp(8)
                            size_hint_y: None
                            height: dp(48)

                            MDRaisedButton:
                                text: "SAVE LINKS"
                                size_hint_x: 0.5
                                md_bg_color: 0.4, 0.4, 0.4, 1
                                on_release: app.save_excel_sync_settings()

                            MDRaisedButton:
                                text: "SAVE ALL LINKS"
                                size_hint_x: 0.5
                                md_bg_color: 0.13, 0.40, 0.16, 1
                                on_release: app.save_excel_sync_settings()

                    # ---------------- DHIS2 Integration ----------------
                    MDCard:
                        orientation: 'vertical'
                        padding: dp(16)
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height
                        radius: [12,]
                        elevation: 2

                        MDBoxLayout:
                            spacing: dp(8)
                            adaptive_height: True

                            MDIcon:
                                icon: "hospital-box-outline"
                                theme_text_color: "Custom"
                                text_color: 0.18, 0.49, 0.20, 1

                            MDLabel:
                                text: "DHIS2 Integration"
                                bold: True
                                font_style: "Subtitle1"
                                adaptive_height: True

                        MDLabel:
                            text: "Pushes attendance to a DHIS2 server: individual check-in/out events plus present/absent totals. Fill in the server and metadata UIDs created in DHIS2's Maintenance app first."
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                        MDLabel:
                            id: dhis2_status_label
                            text: "Not connected"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_height: True

                        MDTextField:
                            id: dhis2_server_url
                            hint_text: "Server URL (e.g. https://play.dhis2.org/40.0.0)"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_username
                            hint_text: "Username"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_password
                            hint_text: "Password"
                            password: True
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_api_token
                            hint_text: "API token (optional - overrides username/password)"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_org_unit
                            hint_text: "Org Unit UID"
                            size_hint_y: None
                            height: dp(48)

                        MDLabel:
                            text: "Tracker (individual attendance)"
                            bold: True
                            font_style: "Caption"
                            adaptive_height: True

                        MDTextField:
                            id: dhis2_tracked_entity_type
                            hint_text: "Tracked Entity Type UID"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_program
                            hint_text: "Program UID (ROHI Staff Attendance)"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_program_stage
                            hint_text: "Program Stage UID"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_tea_staff_id
                            hint_text: "Tracked Entity Attribute UID - Staff ID"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_tea_full_name
                            hint_text: "Tracked Entity Attribute UID - Full Name"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_de_check_in
                            hint_text: "Data Element UID - Check-in time"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_de_check_out
                            hint_text: "Data Element UID - Check-out time"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_de_late
                            hint_text: "Data Element UID - Late (Yes/No)"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_de_gps_status
                            hint_text: "Data Element UID - GPS status"
                            size_hint_y: None
                            height: dp(48)

                        MDLabel:
                            text: "Aggregate (present/absent totals)"
                            bold: True
                            font_style: "Caption"
                            adaptive_height: True

                        MDTextField:
                            id: dhis2_agg_data_set
                            hint_text: "Aggregate Data Set UID"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_agg_de_present
                            hint_text: "Data Element UID - Present count"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_agg_de_absent
                            hint_text: "Data Element UID - Absent count"
                            size_hint_y: None
                            height: dp(48)

                        MDTextField:
                            id: dhis2_agg_de_late
                            hint_text: "Data Element UID - Late count (optional)"
                            size_hint_y: None
                            height: dp(48)

                        MDRaisedButton:
                            text: "SAVE DHIS2 SETTINGS"
                            md_bg_color: 0.4, 0.4, 0.4, 1
                            on_release: app.save_dhis2_settings()

                        MDRaisedButton:
                            text: "TEST DHIS2 CONNECTION"
                            md_bg_color: 0.25, 0.45, 0.75, 1
                            on_release: app.test_dhis2_connection()

                    # ---------------- Actions ----------------
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height

                        MDRaisedButton:
                            id: test_connection_btn
                            text: "TEST CONNECTION"
                            size_hint_x: 1
                            md_bg_color: 0.25, 0.45, 0.75, 1
                            on_release: app.server_connection_test()

                        MDRaisedButton:
                            id: save_settings_btn
                            text: "SAVE SETTINGS"
                            size_hint_x: 1
                            md_bg_color: 0.4, 0.4, 0.4, 1
                            on_release: app.server_connection_save()

                        MDRaisedButton:
                            id: connect_btn
                            text: "CONNECT"
                            size_hint_x: 1
                            md_bg_color: 0.13, 0.40, 0.16, 1
                            on_release: app.server_connection_connect()

                        MDRaisedButton:
                            id: disconnect_btn
                            text: "DISCONNECT"
                            size_hint_x: 1
                            md_bg_color: 0.8, 0.1, 0.1, 1
                            on_release: app.server_connection_disconnect()

                        MDRaisedButton:
                            id: sync_now_btn
                            text: "SYNCHRONIZE NOW"
                            size_hint_x: 1
                            md_bg_color: 0.85, 0.65, 0.13, 1
                            on_release: app.server_connection_sync_now()